{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[0-9]{4,6}$/)",
        ".write": "$room.matches(/^[0-9]{4,6}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt'])"
        },
        "state": {
          "$key": {
            ".validate": "$key.matches(/^[A-Za-z0-9_]{1,40}$/) && newData.isString() && newData.val().length < 200000"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "sessions": {
      ".read": true,
      "$sid": {
        ".validate": "$sid.matches(/^[a-z0-9]{6,12}-[a-z0-9]{4,8}$/)",
        "info": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['participant', 'role', 'startedAt']) && newData.child('participant').isString() && newData.child('participant').val().length <= 12"
        },
        "events": {
          "$eid": {
            ".write": "!data.exists() && root.child('sessions').child($sid).child('info').exists()",
            ".validate": "newData.hasChildren(['t', 'type']) && newData.child('type').isString() && newData.child('type').val().length <= 40"
          }
        },
        "tasks": {
          "$task": {
            ".write": "root.child('sessions').child($sid).child('info').exists() && !root.child('sessions').child($sid).child('summary').exists()",
            ".validate": "$task.matches(/^[A-Z][A-Z0-9]{0,3}$/) && newData.hasChildren(['status'])"
          }
        },
        "summary": {
          ".write": "!data.exists() && root.child('sessions').child($sid).child('info').exists()",
          ".validate": "newData.hasChildren(['confidence', 'endedAt']) && (!newData.child('note').exists() || newData.child('note').val().length <= 1000)"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
